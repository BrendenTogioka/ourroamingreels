---
interface Props {
  heroSequenceUrl?: string
}
const { heroSequenceUrl = '' } = Astro.props
---

<!-- .hero-sticky pins the visuals via CSS position:sticky (no GSAP pin — that
     broke scroll tracking on mobile). Currently .hero is just 100vh (no scroll
     track) — ⚑ TEMP: to be replaced with a proper background video reel. -->
<section class="hero" id="hero">
  <div class="hero-sticky">
  <div class:list={['hero-img-wrap', heroSequenceUrl && 'hero-img-wrap--fill']} id="hero-img-wrap">
    <img
      src="https://res.cloudinary.com/dlle6kl4n/video/upload/so_0/v1779987514/OurRoamingReels/hero-bg.jpg"
      alt="Our Roaming Reels — a field journal from the edges of the earth"
      fetchpriority="high"
      loading="eager"
      decoding="sync"
    />
    {/* The poster stays VISIBLE under the video — it paints instantly
        (eager / high priority), so the hero is never blank while the video
        loads. The video fades in on top once it can play (.is-ready). */}
    {heroSequenceUrl && (
      <video
        id="hero-video"
        class="hero-video"
        aria-hidden="true"
        autoplay
        muted
        loop
        playsinline
        preload="auto"
      >
        <source src={heroSequenceUrl} type="video/mp4" />
      </video>
    )}
  </div>

  <div class="hero-overlay"></div>

  <div class="hero-content">
    <div class="hero-location">
      <div class="hero-location-dot"></div>
      <span>No Fixed Location — Always Moving</span>
    </div>

    <h1 class="hero-title" aria-label="Our Roaming Reels">
      <span class="line">OUR ROAMING</span>
      <span class="line accent">REELS</span>
    </h1>
  </div>

  {/* Sibling of .hero-content (not nested) so it can be pinned to the bottom
      of .hero-sticky independently of the vertically-centered title block. */}
  <div class="hero-sub">
    <div class="hero-scroll-cue">
      <span>Descend</span>
      <div class="scroll-bar"></div>
    </div>
  </div>
  </div><!-- /.hero-sticky -->
</section>
